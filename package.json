{
  "name": "@bil/launchpad",
  "version": "0.1.0",
  "description": "BIL platform code as a single npm package — proxy, analytics, bible (YouVersion), share, OG card gen, opt-in modules, pre-made route handlers. Consumed by the bil-app-template student starter.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "exports": {
    "./proxy": "./src/proxy/index.ts",
    "./bible": "./src/bible/server.ts",
    "./analytics/server": "./src/analytics/server.ts",
    "./analytics/client": "./src/analytics/client.ts",
    "./share/client": "./src/share/client.ts",
    "./share/server": "./src/share/server.tsx",
    "./examples/*": "./src/examples/*",
    "./routes/track": "./src/routes/track.ts",
    "./routes/bible": "./src/routes/bible.ts",
    "./routes/og": "./src/routes/og.tsx",
    "./routes/health": "./src/routes/health.ts",
    "./config/next": "./src/config/next.ts"
  },
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun src/bible/server.test.ts",
    "smoke": "bun run typecheck && bun run test"
  },
  "peerDependencies": {
    "@vercel/og": "^0.11.1",
    "next": ">=16.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "posthog-node": "^5.33.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/og": "^0.11.1",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5"
  }
}
