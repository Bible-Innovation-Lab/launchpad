{
  "name": "@bil/launchpad",
  "version": "0.1.0",
  "description": "BIL platform code as a single npm package — security proxy, Bible (YouVersion), and analytics with auto page-view tracking. Consumed by the bil-app-template student starter.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "exports": {
    "./proxy": "./src/proxy/index.ts",
    "./bible": "./src/bible/server.ts",
    "./analytics/client": "./src/analytics/client.ts",
    "./analytics/page-view-tracker": "./src/analytics/page-view-tracker.tsx",
    "./feedback": "./src/feedback/feedback-modal.tsx",
    "./routes/analytics": "./src/routes/analytics.ts",
    "./config/next": "./src/config/next.ts"
  },
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun src/bible/server.test.ts && bun src/analytics/bot-filter.test.ts && bun src/analytics/client.test.ts",
    "smoke": "bun run typecheck && bun run test"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5"
  }
}
