# BIL Launchpad — environment template.
# Copy to .env.local for development. Production env vars are injected by
# the BIL provisioning service when you run ./scripts/setup.sh.
#
# Analytics (PostHog) intentionally NOT listed here. Production deploys
# get POSTHOG_KEY injected automatically by bil-provisioning. Local dev
# never sends to PostHog — events log to the terminal instead. Keeps the
# BIL central dashboard clean of developer test events.

# --- App identity ------------------------------------------------------------
# Set per-product. Used as a PostHog property so the central dashboard can
# slice across all 50 products. Subdomain-safe slug.
APP_ID=my-app

# --- Development toggles -----------------------------------------------------
# Set NEXT_PUBLIC_DISABLE_GEO=1 to skip the US-only geo-block in local dev
# (handy if you're on a VPN that geo-locates non-US). Production deploys
# always enforce US-only.
# NEXT_PUBLIC_DISABLE_GEO=1

# --- Provisioning service ----------------------------------------------------
# Override only if you're running a staging provisioning service.
# BIL_PROVISIONING_URL=https://provisioning.bibleinnovationlab.org/provision

# --- Auth module (only if modules/auth/ enabled) -----------------------------
# AUTH_SECRET=  (generate: openssl rand -base64 32)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_APPLE_ID=
# AUTH_APPLE_SECRET=

# --- Push module (only if modules/push/ enabled) -----------------------------
# Generate: bunx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=mailto:program@bibleinnovationlab.org
# CRON_SECRET=  (random string; Vercel Cron sends this header to /api/push/send)
